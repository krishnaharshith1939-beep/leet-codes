14)[detect capital]class Solution {
    public boolean detectCapitalUse(String word) {
        int n = word.length();
        int uppercaseCount = 0;
        
        for (int i = 0; i < n; i++) {
            if (Character.isUpperCase(word.charAt(i))) {
                uppercaseCount++;
            }
        }
        
        // Case 1: All capitals or Case 2: All lowercase
        if (uppercaseCount == n || uppercaseCount == 0) {
            return true;
        }
        
        // Case 3: Only the first letter is capital
        if (uppercaseCount == 1 && Character.isUpperCase(word.charAt(0))) {
            return true;
        }
        
        return false;
    }
}

15)[reverse prefix of a word]class Solution {
    public String reversePrefix(String word, char ch) {
        // Find the index of the first occurrence of character ch
        int idx = word.indexOf(ch);
        
        // If ch does not exist in word, do nothing and return original word
        if (idx == -1) {
            return word;
        }
        
        // Convert string to character array to easily reverse the prefix
        char[] arr = word.toCharArray();
        int left = 0, right = idx;
        
        // Reverse the segment from index 0 to idx
        while (left < right) {
            char temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;
            left++;
            right--;
        }
        
        // Convert the character array back to a string
        return new String(arr);
    }
}

