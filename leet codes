class Solution {
    public int numIdenticalPairs(int[] nums) {
        int goodPairs = 0;
        int[] count = new int[101]; // Constraints: 1 <= nums[i] <= 100
        
        for (int num : nums) {
            // Add the number of times we've already seen this value
            goodPairs += count[num];
            // Increment its frequency
            count[num]++;
        }
        
        return goodPairs;
    }
